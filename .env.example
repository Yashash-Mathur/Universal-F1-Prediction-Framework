# ── Local dev defaults (copy to .env and edit) ───────────────────────────────
# SQLite (zero-config dev) — just works out of the box
DATABASE_URL=sqlite:///./data/f1_platform.db

# PostgreSQL (Docker / production)
# DATABASE_URL=postgresql+psycopg2://f1user:f1pass@localhost:5432/f1_predictions

# Redis for rate limiting (optional — in-memory fallback used if not set)
# REDIS_URL=redis://localhost:6379/0

# Default dev API key (hashed and stored in DB during seed)
DEFAULT_ADMIN_KEY=f1_dev_key_2026

# production | development
ENVIRONMENT=development
